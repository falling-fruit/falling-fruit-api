{
  "name": "falling-fruit-api",
  "description": "Falling Fruit API",
  "version": "0.3.0",
  "private": true,
  "author": {
    "name": "Ethan Welty",
    "email": "ethan@fallingfruit.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/falling-fruit/api.git"
  },
  "engines": {
    "node": "^22.16.0",
    "yarn": ">= 1.22.17"
  },
  "license": "GPL-3.0",
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "yarn test:unit && yarn test:e2e",
    "test:unit": "node --import tsx --test 'test/**/*.test.js'",
    "test:e2e": "yarn build && yarn db:up && yarn db:migrate && node --import tsx --test 'test/**/*.e2e.js'",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "db:migrate": "dbmate --env-file .env.test up",
    "build": "tsx scripts/build-openapi.ts",
    "validate": "yarn build && npx swagger-cli validate docs/openapi.yml"
  },
  "dependencies": {
    "@apidevtools/swagger-cli": "^4.0.4",
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "aws-sdk": "^2.1015.0",
    "base64url": "^3.0.1",
    "bcrypt": "^5.0.1",
    "bluebird": "^3.7.2",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "express": "^4.20.0",
    "express-recaptcha": "^5.0.2",
    "js-yaml": "^3.14.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "2.4.0",
    "openapi-types": "^12.1.3",
    "pg-monitor": "2.0.0",
    "pg-promise": "^11.5.5",
    "postmark": "^2.7.8",
    "sharp": "^0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bluebird": "^3.5.42",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^3.12.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.16.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
