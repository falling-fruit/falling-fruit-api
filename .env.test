# Test database configuration (dockerized PostGIS from docker-compose.yml)
# Host port is 5433 by default to avoid clashing with a local Postgres on 5432.
DB=postgres://fallingfruit:fallingfruit@localhost:5433/fallingfruit_db?sslmode=disable

# dbmate uses DATABASE_URL
DATABASE_URL=postgres://fallingfruit:fallingfruit@localhost:5433/fallingfruit_db?sslmode=disable
DBMATE_MIGRATIONS_DIR=./migrations
DBMATE_NO_DUMP_SCHEMA=1

NODE_ENV=test
