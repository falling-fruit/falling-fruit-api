# NODE_ENV=development uses logging stubs for Postmark and S3 (leave their
# credentials unset); NODE_ENV=production requires Postmark and S3 credentials
# NODE_ENV=development uses logging stubs for Postmark and S3 (leave the
# production variables below unset); NODE_ENV=production requires them all
NODE_ENV=development
DB=postgres://username:password@host:port/database
# Production variables (required when NODE_ENV=production, unset for development)
# S3_REGION=us-west-2
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# POSTMARK_API_TOKEN=
JWT_SECRET=
POSTMARK_SECRET_KEY=
POSTMARK_SERVER_ID=
POSTMARK_BROADCAST_STREAM=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
PORT=3300
API_ORIGIN=https://fallingfruit.org
API_BASE=/api/0.3
WEB_ORIGIN=https://beta.fallingfruit.org
