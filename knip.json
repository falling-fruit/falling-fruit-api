{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["test/**/*.{test,e2e}.ts"],
  "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"],
  "ignore": ["src/db/generated/**"],
  "ignoreDependencies": ["openapi-types", "@electric-sql/pglite"],
  "rules": {
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off"
  }
}
